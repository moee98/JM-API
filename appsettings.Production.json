{
  "ConnectionStrings": {
    // Update this to point to SQL Server on the mini PC.
    // If you installed SQL Server Express, the instance name is typically SQLEXPRESS:
    //   "Server=localhost\\SQLEXPRESS;Database=OrderManagement;Trusted_Connection=True;TrustServerCertificate=True;"
    // If you installed the default instance:
    //   "Server=localhost;Database=OrderManagement;Trusted_Connection=True;TrustServerCertificate=True;"
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=OrderManagement;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    // Key must be set via environment variable: JWTKEY (or dotnet user-secrets on the mini PC)
    "Key": "",
    "Issuer": "http://kazadashboard",
    "Audience": "http://kazadashboard"
  },
  "Frontend": {
    "BaseUrl": "http://kazadashboard"
  },
  "Cookies": {
    // Set to false when serving over plain HTTP on a local network (no HTTPS certificate).
    // Set to true if you add an HTTPS certificate in the future.
    "Secure": false
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        // Kestrel listens on localhost only — IIS handles the public-facing port 80.
        "Url": "http://localhost:5000"
      }
    }
  }
}
